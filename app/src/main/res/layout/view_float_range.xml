<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/range_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_range">

    <LinearLayout
        android:id="@+id/range_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_float_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_range_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按住框内拖动 · 右下角缩放"
            android:textColor="#D9FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_brand_solid"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="完成"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_float_btn"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="取消"
            android:textColor="#E6FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/range_handle"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:padding="11dp"
        android:src="@drawable/ic_expand"
        app:tint="#FFFFFF" />

</FrameLayout>
